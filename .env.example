# Copy to .env and fill in real values. Never commit .env to version control.

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=stargazing
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=stargazing

# ── Auth (Phase 0) ─────────────────────────────────────────────────────────────
# Header injected by your auth proxy containing the verified user email.
# Pick the line that matches your setup — delete the others.
#
# Cloudflare Access (recommended if using Cloudflare tunnel):
AUTH_EMAIL_HEADER=Cf-Access-Authenticated-User-Email
#
# oauth2-proxy (self-hosted, no Cloudflare required):
# AUTH_EMAIL_HEADER=X-Auth-Request-Email
#
# Local development — skips header check entirely, signs in as dev@localhost:
# AUTH_BYPASS=true

# ── Auth (Phase 0, oauth2-proxy path only) ────────────────────────────────────
# Only needed if using oauth2-proxy instead of Cloudflare Access.
# OAUTH2_COOKIE_SECRET=   # openssl rand -base64 32
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Django (Phase 1+) ──────────────────────────────────────────────────────────
# DJANGO_SECRET_KEY=   # python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# AUTH_BYPASS=false
