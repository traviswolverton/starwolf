FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libexpat1 \
        libgdal36 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY django/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download DE421 ephemeris (~17MB) at build time so runtime has no cold-start delay
RUN python -c "from skyfield.api import Loader; Loader('/app/ephemeris')('de421.bsp')"

# Copy Django project (engine package is inside django/)
COPY django/ ./django/

WORKDIR /app/django
