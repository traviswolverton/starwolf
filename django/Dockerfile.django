FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libexpat1 \
        libgdal36 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install shared deps (scorer, forecast, bortle, etc.)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Django-specific deps
COPY django/requirements-django.txt .
RUN pip install --no-cache-dir -r requirements-django.txt

# Copy shared Python modules and markdown docs
COPY *.py *.md ./

# Copy Django project
COPY django/ ./django/

# Shared modules live at /app; Django project at /app/django
ENV PYTHONPATH=/app
WORKDIR /app/django
